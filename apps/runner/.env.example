# Optional runner settings. `bun run start` reads this file when it is saved as
# apps/runner/.env and sets the API URL and the runner credential itself.
# SEC_USER_AGENT=your-name you@example.com
# OPENCODE_MODEL=provider/model
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# ALLOW_UNVERIFIED_TOOL_ISOLATION=1
# RUNNER_SCRATCH_ROOT=
# RUNNER_PAGES_DIR=./data/pages

# Only when running the runner by hand against another API (development mode,
# or a deployed Worker): docs/OPERATIONS.md.
# RESEARCH_API_URL=https://your-worker.example.workers.dev
# RUNNER_TOKEN=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
