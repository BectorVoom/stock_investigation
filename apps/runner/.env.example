# Optional runner settings. `bun run start` reads this file when it is saved as
# apps/runner/.env and sets the API URL and the runner credential itself.
# SEC's fair-access policy requires a User-Agent with your name and contact
# e-mail. It enables the SEC research tools AND the US stock list the
# Watchlist searches (ADR-0034); without it the US list reports
# DIRECTORY_NOT_CONFIGURED. The Japanese list (JPX) needs no key.
# SEC_USER_AGENT=your-name you@example.com
# OPENCODE_MODEL=provider/model
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_FREE_MODEL=
# Claude API backend (metered, billed to your Anthropic account): an API key
# from the Claude Console. The model is chosen in Settings → AI agent.
# ANTHROPIC_API_KEY=

# Tavily API key for web.search, the whole-web search research tool (ADR-0025).
# Free plan: 1,000 searches a month. Without it only news.search (GDELT) is offered.
# TAVILY_API_KEY=
# FRED_API_KEY=
# TWELVE_DATA_API_KEY=
# TWELVE_DATA_REQUESTS_PER_MINUTE=8
# Twelve Data requests per UTC day: the Basic plan's 800 by default; 0 = no daily limit (paid plans).
# TWELVE_DATA_DAILY_LIMIT=800

# Daily prices of every listed stock (ADR-0058). Without a key that market's
# stock prices fail with SOURCE_NOT_CONFIGURED; the other market still works.
# Massive (formerly Polygon.io) key for US stock prices; the free Basic plan
# allows 5 requests a minute, end of day, two years of history.
# MASSIVE_API_KEY=
# MASSIVE_REQUESTS_PER_MINUTE=5
# J-Quants V2 API key (dashboard → API Keys) for Japanese stock prices, the
# Japanese companies' annual financial statements and company profiles
# (ADR-0059). Without it JP prices and financial syncs fail with
# SOURCE_NOT_CONFIGURED / FINANCIAL_SOURCE_NOT_CONFIGURED. The Free plan
# publishes 5 requests a minute but sustained about 3 when measured
# (2026-11-02), and is about 12 weeks behind; the earnings summaries have
# their own 60 a minute (not configurable).
# JQUANTS_API_KEY=
# JQUANTS_REQUESTS_PER_MINUTE=3
# Days the J-Quants plan is behind: 84 on Free (12 weeks), 0 on a paid plan.
# JQUANTS_DELAY_DAYS=84

# Finnhub API key for earnings dates of US watchlist stocks (FR-018).
# Without it US stocks report SOURCE_NOT_CONFIGURED; JPX needs no key.
# FINNHUB_API_KEY=
# Google Calendar sync (FR-019): an OAuth client of type "Desktop app".
# Without both values every google-calendar job fails with
# GOOGLE_NOT_CONFIGURED (see docs/OPERATIONS.md for the setup steps).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Where the runner keeps the Google refresh token (mode 0600). The launch
# plans set this beside runner-credential.json; the default is only for
# hand runs.
# GOOGLE_TOKEN_FILE=
# ALLOW_UNVERIFIED_TOOL_ISOLATION=1
# RUNNER_SCRATCH_ROOT=
# RUNNER_PAGES_DIR=./data/pages

# Only when running the runner by hand against another API (development mode,
# or a deployed Worker): docs/OPERATIONS.md.
# RESEARCH_API_URL=https://your-worker.example.workers.dev
# RUNNER_TOKEN=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
