{
	"name": "stock-investigation",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"examples"
	],
	"scripts": {
		"start": "bun run prod",
		"dev": "bun run scripts/dev.ts",
		"prod:build": "bun run scripts/prodBuild.ts",
		"prod:start": "bun run scripts/prodStart.ts",
		"prod:rollback": "bun run scripts/prodRollback.ts",
		"prod": "bun run prod:build && bun run prod:start",
		"build:web": "vite build --config apps/web/vite.config.ts",
		"build:runner": "bun build apps/runner/src/main.ts --target=node --outfile dist/runner/main.mjs",
		"build:runner:rust": "cargo build --release --locked -p research-runner",
		"mcp:home": "bun apps/mcp/src/main.ts",
		"mcp:home:dev": "bun apps/mcp/src/main.ts --api http://127.0.0.1:8788",
		"build": "bun run build:web && bun run build:runner && wrangler deploy --dry-run --env production --config infra/wrangler.jsonc --outdir dist/worker",
		"runner": "bun run build:runner && node dist/runner/main.mjs",
		"runner:rust": "bun run build:runner:rust && \"${CARGO_TARGET_DIR:-target}/release/research-runner\"",
		"db:migrate:local": "wrangler d1 migrations apply research --local --config infra/wrangler.jsonc --persist-to data/d1",
		"typecheck": "bun run scripts/typecheck.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "vitest run",
		"test:e2e": "bun run scripts/e2eAll.ts",
		"test:e2e:chrome": "E2E_BROWSER=chrome playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:firefox": "E2E_BROWSER=firefox playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:webkit": "E2E_BROWSER=webkit playwright test --config tests/e2e/playwright.config.ts",
		"test:real": "playwright test --config tests/real/playwright.config.ts",
		"test:real:live": "playwright test --config tests/real/playwright.config.ts live.spec.ts",
		"test:live:opencode": "RUN_LIVE_OPENCODE=1 node_modules/.bin/vitest run --project node tests/live/opencodePipeline.test.ts && RUN_LIVE_OPENCODE=1 node_modules/.bin/playwright test --config tests/e2e/playwright.config.ts opencodeLive",
		"verify": "bun run check && bun run typecheck && bun run test && bun run vectors:check && bun run rust:check && bun run rust:test && bun run build",
		"formal:check": "sh scripts/formal-check.sh",
		"bench": "node scripts/bench.ts",
		"vectors": "node scripts/vectors/index.ts",
		"vectors:check": "node scripts/vectors/index.ts --check",
		"rust:check": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
		"rust:test": "cargo test --workspace --locked",
		"deploy": "bun run scripts/deploy.ts",
		"db:migrate:remote": "wrangler d1 migrations apply research --remote --env production --config infra/wrangler.jsonc",
		"review:ui": "playwright test --config tests/ui-review/playwright.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@cloudflare/workers-types": "^5.20261011.1",
		"@playwright/test": "^1.64.0",
		"@research/adapters": "workspace:*",
		"@research/agent-core": "workspace:*",
		"@research/application": "workspace:*",
		"@research/contracts": "workspace:*",
		"@research/domain": "workspace:*",
		"@research/effects": "workspace:*",
		"@research/widget-grid": "workspace:*",
		"@solidjs/testing-library": "^0.8.10",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.0.0",
		"fast-check": "^4.10.2",
		"happy-dom": "^20.14.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vite-plugin-solid": "^2.11.12",
		"vitest": "^4.1.0",
		"wrangler": "^4.70.0",
		"zod": "^4.6.5"
	}
}
